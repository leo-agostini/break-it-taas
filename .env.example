# Local kind cluster. kind derives its kubectl context as kind-<cluster>, so
# WORKLOAD_CONTEXT must stay in lockstep with WORKLOAD_CLUSTER_NAME; the
# bootstrap script refuses to continue if they disagree.
WORKLOAD_CLUSTER_NAME=taas-dev
WORKLOAD_CONTEXT=kind-taas-dev
APP_NAMESPACE=app

# Ports the Compose stack publishes on the host. Runner pods reach both
# through the kind network gateway.
API_PORT=3001
LOAD_TARGET_PORT=8080
