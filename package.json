{
  "name": "break-it-taas",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "api": "npm --workspace backend run dev",
    "worker": "npm --workspace backend run worker:dev",
    "dev:up": "bash ops/run-with-env.sh bash ops/dev-up.sh",
    "dev:down": "bash ops/run-with-env.sh bash ops/dev-down.sh",
    "smoke": "bash ops/run-with-env.sh bash ops/smoke-test.sh",
    "test:integration": "npm --workspace backend run test:integration",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^22.15.3",
    "husky": "^9.1.7",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "type": "module",
  "dependencies": {},
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "argon2@0.44.0": true,
    "esbuild@0.25.12": true
  }
}
