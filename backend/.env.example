TZ=UTC
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── App ───────────────────────────────────────────────────────────────────────
# Encrypts and signs the session cookie. Generate with: node ace generate:key
APP_KEY=
APP_URL=http://localhost:${PORT}

# ── Session (see docs/03-decisions/ADR-008-session-auth.md) ───────────────────
# The session cookie is the only auth credential. Frontend and backend are
# deployed on independent public hostnames, so in production the cookie must be
# sent cross-site:
#   - SESSION_SAMESITE=none is required for the browser to send the cookie on a
#     cross-origin request, and SameSite=None is only honored with Secure (the
#     session config forces Secure whenever SameSite is none).
# Local same-host dev keeps lax/false.
SESSION_DRIVER=cookie
SESSION_SAMESITE=lax
SESSION_SECURE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins. Credentials ride on every
# request, and browsers reject Access-Control-Allow-Origin: * combined with
# credentials, so `*` only means "reflect the request Origin" — a local-dev
# convenience, not a production setting.
# Production example: CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=*

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL runs outside the cluster: Docker Compose locally, a separate
# infrastructure component elsewhere.
# • API on the host:        postgres://postgres:postgres@localhost:5432/app
# • API inside Compose:     postgres://postgres:postgres@postgres:5432/app
# Tests use .env.test, which points at a separate `app_test` database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# ── Integration tests ─────────────────────────────────────────────────────────
# The suite is gated so `npm test` never reaches for a live cluster. Do not set
# RUN_CLUSTER_INTEGRATION here — `test:integration` and ops/smoke-test.sh set it
# themselves.
INTEGRATION_BASE_URL=http://localhost:3001
INTEGRATION_KUBECONFIG_CONTEXT=kind-taas-dev
# The load target runs in Compose. Runner pods reach it through the kind network
# gateway, which the suite resolves from Docker at run time; set these only to
# override that.
# INTEGRATION_TARGET_BASE_URL=http://172.18.0.1:8080
# INTEGRATION_TARGET_PORT=8080
INTEGRATION_TARGET_CONTAINER=breakit-load-target

# ── Runner (required) ─────────────────────────────────────────────────────────
RUNNER_SHARED_SECRET=replace-this-runner-secret

# URL the k6 runner pod uses to POST results back to the API. Runner pods run
# inside the cluster and cannot reach localhost.
# • API on the host (hybrid):  the kind network gateway, usually 172.18.0.1
# • API in the cluster:        http://backend.app.svc.cluster.local
# Verify either with: bash ops/kind/probe-callback.sh
RUNNER_CALLBACK_BASE_URL=http://<host-ip-reachable-from-kind>:3001

RUNNER_IMAGE=breakit-k6-runner:local
# Runner Job scheduling. Leave both empty on kind: it has no sandboxed
# runtime class and one homogeneous node pool. Managed clusters set them,
# e.g. GKE Sandbox: RUNNER_RUNTIME_CLASS=gvisor with
# RUNNER_NODE_SELECTOR=sandbox.gke.io/runtime=gvisor
RUNNER_RUNTIME_CLASS=
RUNNER_NODE_SELECTOR=

KUBERNETES_NAMESPACE=app
KUBERNETES_CONTEXT=kind-taas-dev

# OpenTelemetry (@adonisjs/otel). Traces and metrics go over OTLP/HTTP to Alloy;
# logs are not exported, Alloy already tails stdout. To turn the SDK off, set
# OTEL_SDK_DISABLED=true in the process environment: it is read before this
# file is loaded, so it has no effect here. docker-compose.yml sets it to true
# unless the stack runs with OBSERVABILITY=1.
APP_NAME=breakit-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
