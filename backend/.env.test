# Overrides applied on top of .env when NODE_ENV=test (node ace test).
# Functional tests migrate and truncate this database, so it must never be the
# development one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test
SESSION_DRIVER=memory
LOG_LEVEL=warn
RUNNER_SHARED_SECRET=test-runner-shared-secret
RUNNER_CALLBACK_BASE_URL=http://localhost:3001
