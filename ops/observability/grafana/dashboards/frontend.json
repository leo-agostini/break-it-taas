{
  "uid": "breakit-frontend",
  "title": "Frontend",
  "description": "Browser telemetry from Grafana Faro: sessions, page views, exceptions, console logs, API errors and Core Web Vitals.",
  "tags": [
    "breakit",
    "frontend",
    "faro"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Search logs",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Usage and errors \u2014 selected range",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Sessions",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (session_id) (count_over_time({source=\"faro\", app_name=\"breakit-frontend\"} | logfmt session_id [$__range])))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "description": "Distinct Faro sessions with any activity in the range. Sessions persist across reloads and end after 15 minutes of inactivity."
    },
    {
      "type": "stat",
      "title": "Page views",
