        {
          "refId": "A",
          "expr": "(count(sum by (session_id) (count_over_time({source=\"faro\", app_name=\"breakit-frontend\", kind=\"exception\"} | logfmt session_id [$__range]))) or vector(0)) / count(sum by (session_id) (count_over_time({source=\"faro\", app_name=\"breakit-frontend\"} | logfmt session_id [$__range])))",
