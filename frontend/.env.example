# All VITE_* variables consumed by the app are declared and defaulted in
# frontend/src/lib/env.ts — add new ones there, not inline in feature code.

# Frontend and backend are deployed on independent public hostnames (see
# docs/03-decisions/ADR-004-cross-domain-httponly-cookie-auth.md). Both the
# browser and the SSR process call the backend's real absolute URL directly —
# there is no same-origin proxy path to rely on.
#   VITE_API_URL=https://<real-backend-domain>/api        # used by the browser
#   VITE_API_SERVER_URL=https://<real-backend-domain>/api # used by the SSR process
# VITE_API_SERVER_URL may instead point at an internal/private URL if the SSR
# process and backend happen to share a private network, but it does not need to.
VITE_API_URL=/api
VITE_API_SERVER_URL=http://localhost:3001/api

# Dev-server only: target of the `/api` proxy in vite.config.ts. Read via
# process.env at config time (Node), so it is not part of src/lib/env.ts.
# VITE_API_PROXY_TARGET=http://app.127.0.0.1.sslip.io
